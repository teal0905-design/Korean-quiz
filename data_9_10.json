  "grammars": [
    {
      "id": "g_l9_1",
      "lessonId": "lesson-9",
      "title": "-는데 / -(으)ㄴ데 (轉折)",
      "formula": "動詞+-는데 / 形容詞+-(으)ㄴ데",
      "explanation": "表示對前一子句的事實，後一子句表現出相反或對比的情況。",
      "exampleKr": "여름은 더운<span class=\"hl-red\">데</span> 겨울은 춥습니다. (夏天熱，但冬天冷。)"
    },
    {
      "id": "g_l9_2",
      "lessonId": "lesson-9",
      "title": "-(으)ㄹ 수 있다 (能夠)",
      "formula": "動詞語幹 + -(으)ㄹ 수 있다",
      "explanation": "表示有做某種行為的能力，或是具備可能性。",
      "exampleKr": "스키를 탈 <span class=\"hl-red\">수 있는</span> 겨울. (可以滑雪的冬天。)"
    },
    {
      "id": "g_l9_3",
      "lessonId": "lesson-9",
      "title": "-(으)ㄴ 후에 (在...之後)",
      "formula": "動詞語幹 + -(으)ㄴ 후에",
      "explanation": "表示前一個動作結束後，接著發生後一個動作。",
      "exampleKr": "비가 온 <span class=\"hl-red\">후에</span>는 날씨가 맑겠지요? (下雨之後天氣會放晴吧？)"
    },
    {
      "id": "g_l9_4",
      "lessonId": "lesson-9",
      "title": "보다 (比...更...)",
      "formula": "名詞 + -보다",
      "explanation": "用於比較兩個事物，接在「被比較」的對象後面。",
      "exampleKr": "오늘<span class=\"hl-red\">보다</span> 따뜻할 것 같아요. (好像會比今天溫暖。)"
    },
    {
      "id": "g_l9_5",
      "lessonId": "lesson-9",
      "title": "-(으)ㄹ 것 같다 (推測)",
      "formula": "動詞/形容詞語幹 + -(으)ㄹ 것 같다",
      "explanation": "表示對將來的動作或狀態的推測（好像會...）。",
      "exampleKr": "곧 비가 올 <span class=\"hl-red\">것 같아요</span>. (好像快下雨了。)"
    },
    {
      "id": "g_l9_6",
      "lessonId": "lesson-9",
      "title": "-고 있다 (正在進行)",
      "formula": "動詞語幹 + -고 있다",
      "explanation": "表示動作正在進行或持續中。",
      "exampleKr": "운동을 하<span class=\"hl-red\">고 있어요</span>. (正在運動。)"
    },
    {
      "id": "g_l10_1",
      "lessonId": "lesson-10",
      "title": "-(으)려고 하다 (打算/計畫)",
      "formula": "動詞語幹 + -(으)려고 하다",
      "explanation": "表示計畫或意圖要做某件事情。",
      "exampleKr": "설악산에 가<span class=\"hl-red\">려고 해요</span>. (打算去雪嶽山。)"
    },
    {
      "id": "g_l10_2",
      "lessonId": "lesson-10",
      "title": "동안 (期間)",
      "formula": "時間名詞 + 동안",
      "explanation": "表示一段時間的「期間」。",
      "exampleKr": "이 주일 <span class=\"hl-red\">동안</span> 방학이에요. (放假兩個星期。)"
    },
    {
      "id": "g_l10_3",
      "lessonId": "lesson-10",
      "title": "-(으)ㄹ 때 (當...時)",
      "formula": "動詞/形容詞語幹 + -(으)ㄹ 때",
      "explanation": "表示動作發生的時間點。",
      "exampleKr": "시간이 있<span class=\"hl-red\">을 때</span>는 여행을 가요. (有時間的時候去旅行。)"
    },
    {
      "id": "g_l10_4",
      "lessonId": "lesson-10",
      "title": "중에서 (在...之中)",
      "formula": "名詞 + 중에서",
      "explanation": "在多個對象或範圍中做選擇，常跟 제일 (最) 連用。",
      "exampleKr": "여행하신 곳 <span class=\"hl-red\">중에서</span> 어디가 제일 좋았어요? (旅行過的地方中，哪裡最好？)"
    },
    {
      "id": "g_l10_5",
      "lessonId": "lesson-10",
      "title": "-기 전에 (在...之前)",
      "formula": "動詞語幹 + -기 전에",
      "explanation": "表示在做某個動作之前。",
      "exampleKr": "탁구를 배우<span class=\"hl-red\">기 전에</span>는 별로 안 했어요. (學桌球之前不太常打。)"
    },
    {
      "id": "g_l10_6",
      "lessonId": "lesson-10",
      "title": "못 / -지 못하다 (不能/無法)",
      "formula": "못 + 動詞 / 動詞+-지 못하다",
      "explanation": "表示「沒有能力」或「客觀條件不允許」做到某事。",
      "exampleKr": "극장에 자주 <span class=\"hl-red\">못</span> 가요. (無法常去電影院。)"
    }
