  "grammars": [
    {
      "id": "g_l3_1",
      "lessonId": "lesson-3",
      "title": "을 / 를",
      "formula": "名詞 + 을 / 를",
      "explanation": "受格助詞，標示動作支配的目的對象（賓語）。<br>• <b>有尾音</b> 接 <b>을</b><br>• <b>無尾音</b> 接 <b>를</b>",
      "exampleKr": "【有尾音】：가족 사진<span class=\"hl-red\">을</span> 봅니다. (看家人的照片。)<br>【無尾音】：노래<span class=\"hl-red\">를</span> 부릅니다. (唱歌。)"
    },
    {
      "id": "g_l3_2",
      "lessonId": "lesson-3",
      "title": "-(으)시- / 계시다 (主體尊敬)",
      "formula": "動詞/形容詞語幹 + -(으)시-",
      "explanation": "尊敬詞綴，接在動詞/形容詞語幹後表示對句子主語（長輩）的尊敬。<br>• <b>有尾音</b> 接 <b>-으시-</b><br>• <b>無尾音</b> 接 <b>-시-</b><br>• 固有特殊尊敬詞：있다 ➔ <b>계시다</b>、자다 ➔ <b>주무시다</b>、먹다 ➔ <b>드시다</b>",
      "exampleKr": "아버지께서 신문을 읽<span class=\"hl-red\">으십니다</span>. (爸爸看報紙。)<br>할아버지께서 <span class=\"hl-red\">주무십니다</span>. (爺爺在睡覺。)"
    },
    {
      "id": "g_l3_3",
      "lessonId": "lesson-3",
      "title": "-고 (並列連接)",
      "formula": "動詞/形容詞語幹 + 고",
      "explanation": "連接語尾，平等並列兩個以上的狀態或動作（表示「既...又...」或「...而且...」）。",
      "exampleKr": "공기도 좋<span class=\"hl-red\">고</span> 조용합니다. (空氣好又安靜。)<br>교실이 넓<span class=\"hl-red\">고</span> 깨끗합니다. (教室寬敞又乾淨。)"
    },
    {
      "id": "g_l3_4",
      "lessonId": "lesson-3",
      "title": "에서 (活動場所)",
      "formula": "場所名詞 + 에서 + 動詞",
      "explanation": "接在場所名詞後，標示動作或動態事件發生的地點（「在...做某事」）。",
      "exampleKr": "대학교<span class=\"hl-red\">에서</span> 경제학을 공부합니다. (在大學念經濟學。)<br>도서관<span class=\"hl-red\">에서</span> 책을 읽습니다. (在圖書館看書。)"
    },

    {
      "id": "g_l4_1",
      "lessonId": "lesson-4",
      "title": "에 가다 / 오다 (目的地)",
      "formula": "場所名詞 + 에 가다 / 오다",
      "explanation": "表示前往或來到某個目的地（「去/來某處」）。",
      "exampleKr": "식당<span class=\"hl-red\">에 갑니다</span>. (去餐廳。)<br>친구가 우리 집<span class=\"hl-red\">에 옵니다</span>. (朋友來我家。)"
    },
    {
      "id": "g_l4_2",
      "lessonId": "lesson-4",
