  "grammars": [
    {
      "id": "g_l5_1",
      "lessonId": "lesson-5",
      "title": "까지 (終點助詞)",
      "formula": "時間/場所名詞 + 까지",
      "explanation": "表示時間的截止點或空間的抵達終點（「到...為止」）。",
      "exampleKr": "두 시<span class=\"hl-red\">까지</span> 가요. (兩點之前會到。)<br>여기<span class=\"hl-red\">까지</span> 하십시오. (請做到這裡。)"
    },
    {
      "id": "g_l5_2",
      "lessonId": "lesson-5",
      "title": "-아요 / 어요 (日常非格式體終結語尾)",
      "formula": "動詞/形容詞語幹 + -아요 / 어요",
      "explanation": "日常口語中最常用的親切敬語（半敬語）。<br>• <b>陽性母音 (ㅏ, ㅗ)</b> 接 <b>-아요</b><br>• <b>陰性/其他母音</b> 接 <b>-어요</b><br>• <b>하다</b> 變為 <b>해요</b>",
      "exampleKr": "가다 ➔ 가<span class=\"hl-red\">요</span> (走/去) | 먹다 ➔ 먹<span class=\"hl-red\">어요</span> (吃) | 공부하다 ➔ 공부<span class=\"hl-red\">해요</span> (念書)"
    },
    {
      "id": "g_l5_3",
      "lessonId": "lesson-5",
      "title": "-지요? (尋求確認與同意)",
      "formula": "動詞/形容詞語幹 + -지요?",
      "explanation": "用在句尾詢問已推知的事實，尋求聽者的同意或再次確認（「...對吧？」）。",
      "exampleKr": "오늘이 목요일이<span class=\"hl-red\">지요?</span> (今天是星期四對吧？)<br>날씨가 춥<span class=\"hl-red\">지요?</span> (天氣很冷吧？)"
    },
    {
      "id": "g_l5_4",
      "lessonId": "lesson-5",
      "title": "-(으)세요 (日常親切尊敬語尾)",
      "formula": "動詞語幹 + -(으)세요",
      "explanation": "口語中既親切又帶有尊敬語氣的句尾，可用於陳述、疑問或客氣命令（「請...」）。",
      "exampleKr": "내일 뭐 하<span class=\"hl-red\">세요?</span> (您明天做什麼呢？)<br>어서 오<span class=\"hl-red\">세요</span>. (歡迎光臨 / 請進。)"
    },
    {
      "id": "g_l5_5",
      "lessonId": "lesson-5",
      "title": "부터 ~ 까지 (時間與空間起迄)",
      "formula": "起點 + 부터 + 終點 + 까지",
      "explanation": "標示時間或順序的起點與終點（「從...到...」）。",
      "exampleKr": "월요일<span class=\"hl-red\">부터</span> 금요일<span class=\"hl-red\">까지</span> 수업이 있어요. (從星期一到星期五有課。)"
    },
    {
      "id": "g_l5_6",
      "lessonId": "lesson-5",
      "title": "-았/었/였- (過去時態)",
      "formula": "動詞/形容詞語幹 + -았/었/였-",
      "explanation": "標示過去已經發生的事件或動作。<br>• <b>陽性母音 (ㅏ, ㅗ)</b> 接 <b>-았-</b><br>• <b>陰性/其他母音</b> 接 <b>-었-</b><br>• <b>하다</b> 變為 <b>했-</b>",
      "exampleKr": "만나다 ➔ 만<span class=\"hl-red\">났어요</span> (見面了) | 먹다 ➔ 먹<span class=\"hl-red\">었어요</span> (吃了) | 공부하다 ➔ 공부<span class=\"hl-red\">했어요</span> (念書了)"
    },

    {
      "id": "g_l6_1",
      "lessonId": "lesson-6",
      "title": "-(으)러 가다/오다 (移動目的)",
      "formula": "動詞語幹 + -(으)러 가다/오다",
      "explanation": "接在動詞後，表示前往或來此的目的。<br>• <b>有尾音</b> 接 <b>-으러</b><br>• <b>無尾音/ㄹ尾音</b> 接 <b>-러</b>",
      "exampleKr": "선물을 사<span class=\"hl-red\">러 갑니다</span>. (去買禮物。)<br>밥을 먹<span class=\"hl-red\">으러 식당에 가요</span>. (去餐廳吃飯。)"
    },
    {
