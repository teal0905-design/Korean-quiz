  "grammars": [
    {
      "id": "g_l7_1",
      "lessonId": "lesson-7",
      "title": "-(으)로 (方向/手段/工具)",
      "formula": "名詞 + -(으)로",
      "explanation": "表示移動的方向（往哪裡），或是搭乘的交通工具、使用的方法。",
      "exampleKr": "오른쪽<span class=\"hl-red\">으로</span> 가세요. (請向右走。)<br>지하철<span class=\"hl-red\">로</span> 갑니다. (搭地鐵去。)"
    },
    {
      "id": "g_l7_2",
      "lessonId": "lesson-7",
      "title": "-에서 ~까지 (起點到終點)",
      "formula": "場所 + -에서 + 場所 + -까지",
      "explanation": "表示空間上的起點與終點（「從...到...」）。",
      "exampleKr": "여기<span class=\"hl-red\">서</span> 잠실<span class=\"hl-red\">까지</span> 얼마나 걸려요? (從這裡到蠶室要多久？)"
    },
    {
      "id": "g_l7_3",
      "lessonId": "lesson-7",
      "title": "-어서/아서/여서 (順序/原因)",
      "formula": "動詞/形容詞語幹 + -아/어/여서",
      "explanation": "表示前一個動作發生後，接著發生後一個動作（有連貫性）；或表示原因。",
      "exampleKr": "나가<span class=\"hl-red\">서</span> 왼쪽으로 가세요. (出去後往左走。)"
    },
    {
      "id": "g_l7_4",
      "lessonId": "lesson-7",
      "title": "-(으)니까 (原因與理由)",
      "formula": "動詞/形容詞語幹 + -(으)니까",
      "explanation": "表示原因，通常後句會接命令句 (-으세요) 或勸誘句 (-읍시다)。",
      "exampleKr": "사람이 많<span class=\"hl-red\">으니까</span> 조심하세요. (因為人多，請小心。)"
    },
    {
      "id": "g_l7_5",
      "lessonId": "lesson-7",
      "title": "-지 말다 (禁止 / 不要...)",
      "formula": "動詞語幹 + -지 말다",
      "explanation": "構成命令句或勸誘句的否定形式，表示「請不要做某事」。",
      "exampleKr": "여기 앉<span class=\"hl-red\">지 마세요</span>. (請不要坐在這裡。)"
    },
    {
      "id": "g_l8_1",
      "lessonId": "lesson-8",
      "title": "-(으)ㄹ게요 (承諾 / 我會...)",
      "formula": "動詞語幹 + -(으)ㄹ게요",
      "explanation": "向對方表達自己的意願或承諾，主詞只能是第一人稱。",
      "exampleKr": "이따가 전화할<span class=\"hl-red\">게요</span>. (我待會打電話。)"
    },
    {
      "id": "g_l8_2",
      "lessonId": "lesson-8",
      "title": "-(이)나 (選擇 / 或)",
      "formula": "名詞 + -(이)나",
      "explanation": "列舉兩個以上的事物，表示從中選擇其一。",
      "exampleKr": "세 시<span class=\"hl-red\">나</span> 네 시쯤에 전화할게요. (我三點或四點左右打電話。)"
    },
    {
      "id": "g_l8_3",
      "lessonId": "lesson-8",
      "title": "-는데요 / -은/ㄴ데요 (語氣柔和)",
      "formula": "動詞+-는데요 / 形容詞+-(으)ㄴ데요",
      "explanation": "表達某種情況或背景，語氣較委婉，並暗示期待對方回應。",
      "exampleKr": "바로 전<span class=\"hl-red\">데요</span>. (我就是。)"
    },
    {
      "id": "g_l8_4",
      "lessonId": "lesson-8",
      "title": "에게서 / 한테서 (從...那裡)",
      "formula": "人物名詞 + 에게서 / 한테서",
      "explanation": "表示動作的來源，常跟聽(듣다)、收到(받다)、借(빌리다)連用。",
      "exampleKr": "웨이 씨<span class=\"hl-red\">한테서</span> 전화 받았어요? (接到王偉打來的電話了嗎？)"
    },
    {
      "id": "g_l8_5",
      "lessonId": "lesson-8",
      "title": "-(으)면 (假設 / 如果)",
      "formula": "動詞/形容詞語幹 + -(으)면",
      "explanation": "表示假設或條件的「如果」。",
      "exampleKr": "조금 늦으<span class=\"hl-red\">면</span> 전화할게요. (如果會晚一點，我會打電話。)"
    }
  ]
