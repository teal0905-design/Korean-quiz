  "grammars": [
    {
      "id": "g_l1_1",
      "lessonId": "lesson-1",
      "title": "입니다",
      "formula": "名詞 + 입니다",
      "explanation": "接在名詞後，表示肯定身份或狀態「是...」。用於正式、客氣的場合。",
      "exampleKr": "【無尾音】：저<span class=\"hl-red\">는</span> 학생<span class=\"hl-red\">입니다</span>. (我是學生。)<br>【有尾音】：이것은 제 책상<span class=\"hl-red\">입니다</span>. (這是我的書桌。)"
    },
    {
      "id": "g_l1_2",
      "lessonId": "lesson-1",
      "title": "은 / 는",
      "formula": "名詞 + 은 / 는",
      "explanation": "主題助詞，用於介紹話題或形成對比。<br>• <b>有尾音</b> 接 <b>은</b><br>• <b>無尾音</b> 接 <b>는</b>",
      "exampleKr": "【有尾音】：서울<span class=\"hl-red\">은</span> 한국의 수도입니다. (首爾是韓國的首都。)<br>【無尾音】：저<span class=\"hl-red\">는</span> 대만 사람입니다. (我是台灣人。)"
    },
    {
      "id": "g_l1_3",
      "lessonId": "lesson-1",
      "title": "입니까?",
      "formula": "名詞 + 입니까?",
      "explanation": "「입니다」的疑問形式，用於正式場合詢問對方的身份或國籍。",
      "exampleKr": "이분이 어느 나라 사람<span class=\"hl-red\">입니까?</span> (這位是哪國人？)"
    },
    {
      "id": "g_l1_4",
