{
  "questions": [
    { "id": 701, "lessonId": "lesson-7", "grammarId": "g_l7_1", "zh": "請向右邊走。", "kr": "오른쪽으로 가세요", "extra": ["왼쪽으로", "오른쪽에"] },
    { "id": 702, "lessonId": "lesson-7", "grammarId": "g_l7_1", "zh": "請走斑馬線過馬路。", "kr": "횡단보도로 건너세요", "extra": ["육교로", "건넜어요"] },
    { "id": 703, "lessonId": "lesson-7", "grammarId": "g_l7_1", "zh": "請在十字路口右轉。", "kr": "사거리에서 우회전하세요", "extra": ["사거리로", "좌회전하세요"] },
    { "id": 704, "lessonId": "lesson-7", "grammarId": "g_l7_1", "zh": "搭地鐵要花四十分鐘。", "kr": "지하철로 사십 분 걸립니다", "extra": ["지하철이", "걸려요"] },
    { "id": 705, "lessonId": "lesson-7", "grammarId": "g_l7_1", "zh": "搭飛機去濟州島。", "kr": "비행기로 제주도에 가요", "extra": ["비행기를", "옵니다"] },
    { "id": 706, "lessonId": "lesson-7", "grammarId": "g_l7_2", "zh": "從首爾站到機場要多久？", "kr": "서울역에서 공항까지 얼마나 걸려요", "extra": ["공항에서", "걸립니까"] },
    { "id": 707, "lessonId": "lesson-7", "grammarId": ["g_l7_1", "g_l7_2"], "zh": "從家裡到學校搭公車去。", "kr": "집에서 학교까지 버스로 가요", "extra": ["버스를", "학교에서"] },
    { "id": 708, "lessonId": "lesson-7", "grammarId": "g_l7_2", "zh": "從這裡到蠶室請搭地鐵。", "kr": "여기서 잠실까지 지하철을 타세요", "extra": ["잠실에서", "타요"] },
    { "id": 709, "lessonId": "lesson-7", "grammarId": ["g_l7_1", "g_l7_3"], "zh": "出去後請往左走。", "kr": "나가서 왼쪽으로 가세요", "extra": ["나오고", "오른쪽으로"] },
    { "id": 710, "lessonId": "lesson-7", "grammarId": "g_l7_3", "zh": "在新村站下車後請轉乘。", "kr": "신촌역에서 내려서 갈아타세요", "extra": ["내리고", "타세요"] },
    { "id": 711, "lessonId": "lesson-7", "grammarId": "g_l7_3", "zh": "在公車站等公車。", "kr": "버스 정류장에서 버스를 기다려요", "extra": ["정류장으로", "기다립니다"] },
    { "id": 712, "lessonId": "lesson-7", "grammarId": "g_l7_4", "zh": "因為人很多，請小心。", "kr": "사람이 많으니까 조심하세요", "extra": ["많아서", "조심해요"] },
    { "id": 713, "lessonId": "lesson-7", "grammarId": "g_l7_4", "zh": "因為沒有時間，我們搭計程車吧。", "kr": "시간이 없으니까 택시를 탑시다", "extra": ["없어서", "탈까요"] },
    { "id": 714, "lessonId": "lesson-7", "grammarId": ["g_l7_1", "g_l7_4"], "zh": "因為路況擁擠，請搭地鐵去。", "kr": "길이 복잡하니까 지하철로 가세요", "extra": ["복잡해서", "지하철이"] },
    { "id": 715, "lessonId": "lesson-7", "grammarId": "g_l7_5", "zh": "請不要坐在這裡。", "kr": "여기 앉지 마세요", "extra": ["앉으세요", "여기에"] },
    { "id": 716, "lessonId": "lesson-7", "grammarId": "g_l7_5", "zh": "請不要在車廂裡奔跑。", "kr": "지하철 안에서 뛰지 마세요", "extra": ["뛰세요", "밖에서"] },
    { "id": 717, "lessonId": "lesson-7", "grammarId": "g_l7_3", "zh": "從這裡到地鐵站走路去。", "kr": "여기서 지하철역까지 걸어서 가요", "extra": ["뛰어서", "걸어가요"] },
    { "id": 718, "lessonId": "lesson-7", "grammarId": "g_l7_4", "zh": "因為地鐵比較快，請搭地鐵。", "kr": "지하철이 더 빠르니까 지하철을 타세요", "extra": ["느리니까", "버스를"] },
    { "id": 719, "lessonId": "lesson-7", "grammarId": "g_l7_1", "zh": "請刷交通卡搭乘。", "kr": "교통카드로 찍고 타세요", "extra": ["현금으로", "내리세요"] },
    { "id": 720, "lessonId": "lesson-7", "grammarId": ["g_l7_1", "g_l7_2"], "zh": "從明洞到東大門搭計程車去。", "kr": "명동에서 동대문까지 택시로 가요", "extra": ["동대문에서", "버스를"] },
    { "id": 721, "lessonId": "lesson-7", "grammarId": "g_l7_3", "zh": "買了交通卡後上了公車。", "kr": "교통카드를 사서 버스를 탔어요", "extra": ["사고", "내렸어요"] },
    { "id": 722, "lessonId": "lesson-7", "grammarId": ["g_l7_4", "g_l7_5"], "zh": "因為路上太塞了，請不要搭計程車。", "kr": "길이 많이 막히니까 택시를 타지 마세요", "extra": ["복잡해서", "타세요"] },
    { "id": 723, "lessonId": "lesson-7", "grammarId": "g_l7_5", "zh": "開車時請不要看手機。", "kr": "운전 중에 휴대전화를 보지 마세요", "extra": ["보세요", "음악을"] },
    { "id": 724, "lessonId": "lesson-7", "grammarId": ["g_l7_1", "g_l7_3"], "zh": "從二號出口出去後請右轉。", "kr": "이 번 출구로 나가서 우회전하세요", "extra": ["일 번", "좌회전하세요"] },
    { "id": 725, "lessonId": "lesson-7", "grammarId": "g_l7_4", "zh": "因為時間晚了，我們快步走過去吧。", "kr": "시간이 늦었으니까 빨리 걸어갑시다", "extra": ["이르니까", "걸었어요"] },

    { "id": 801, "lessonId": "lesson-8", "grammarId": "g_l8_1", "zh": "我稍後會再打電話。", "kr": "이따가 다시 전화할게요", "extra": ["전화했어요", "내일"] },
    { "id": 802, "lessonId": "lesson-8", "grammarId": "g_l8_1", "zh": "我會傳簡訊給您。", "kr": "제가 문자메시지를 보낼게요", "extra": ["보냈어요", "친구가"] },
    { "id": 803, "lessonId": "lesson-8", "grammarId": "g_l8_1", "zh": "我一定會遵守約定。", "kr": "약속을 꼭 지킬게요", "extra": ["어길게요", "약속이"] },
    { "id": 804, "lessonId": "lesson-8", "grammarId": ["g_l8_1", "g_l8_2"], "zh": "我三點或四點左右會打電話。", "kr": "세 시나 네 시쯤에 전화할게요", "extra": ["시에", "전화했어요"] },
    { "id": 805, "lessonId": "lesson-8", "grammarId": "g_l8_2", "zh": "要喝咖啡或綠茶嗎？", "kr": "커피나 녹차를 마실까요", "extra": ["녹차하고", "마십시다"] },
    { "id": 806, "lessonId": "lesson-8", "grammarId": "g_l8_2", "zh": "星期六或星期天見面吧。", "kr": "토요일이나 일요일에 만나요", "extra": ["일요일하고", "만났어요"] },
    { "id": 807, "lessonId": "lesson-8", "grammarId": "g_l8_3", "zh": "喂，我就是。", "kr": "여보세요 바로 전데요", "extra": ["누구예요", "전화입니다"] },
    { "id": 808, "lessonId": "lesson-8", "grammarId": "g_l8_3", "zh": "王偉先生現在正在通話中呢。", "kr": "웨이 씨는 지금 통화 중인데요", "extra": ["통화 중입니다", "있는데요"] },
    { "id": 809, "lessonId": "lesson-8", "grammarId": "g_l8_3", "zh": "王偉先生不在，出去了呢。", "kr": "웨이 씨는 안 계시고 나갔는데요", "extra": ["계시는데요", "나갑니다"] },
    { "id": 810, "lessonId": "lesson-8", "grammarId": "g_l8_4", "zh": "接到了朋友打來的電話。", "kr": "친구한테서 전화를 받았어요", "extra": ["친구에게", "걸었어요"] },
    { "id": 811, "lessonId": "lesson-8", "grammarId": "g_l8_4", "zh": "王偉傳簡訊來了。", "kr": "웨이 씨한테서 문자메시지가 왔어요", "extra": ["보냈어요", "씨에게"] },
    { "id": 812, "lessonId": "lesson-8", "grammarId": "g_l8_4", "zh": "從老師那裡聽到了消息。", "kr": "선생님에게서 이야기를 들었어요", "extra": ["선생님께", "들었습니다"] },
    { "id": 813, "lessonId": "lesson-8", "grammarId": ["g_l8_1", "g_l8_5"], "zh": "如果會晚一點，我會打電話。", "kr": "조금 늦으면 전화할게요", "extra": ["늦으니까", "전화했어요"] },
    { "id": 814, "lessonId": "lesson-8", "grammarId": "g_l8_5", "zh": "如果明天有時間的話，一起吃飯吧。", "kr": "내일 시간 있으면 같이 밥 먹어요", "extra": ["있으니까", "먹읍시다"] },
    { "id": 815, "lessonId": "lesson-8", "grammarId": "g_l8_5", "zh": "如果違背約定的話是不行的。", "kr": "약속을 어기면 안 돼요", "extra": ["지키면", "돼요"] },
    { "id": 816, "lessonId": "lesson-8", "grammarId": "g_l8_5", "zh": "如果不知道電話號碼，請問一下。", "kr": "전화번호를 모르면 물어보세요", "extra": ["몰라서", "가르쳐요"] },
    { "id": 817, "lessonId": "lesson-8", "grammarId": "g_l8_3", "zh": "我不太清楚那個號碼呢。", "kr": "그 번호를 잘 모르겠는데요", "extra": ["알겠는데요", "주소를"] },
    { "id": 818, "lessonId": "lesson-8", "grammarId": "g_l8_1", "zh": "到家後我會用 KakaoTalk 傳訊息給您。", "kr": "집에 도착해서 카톡 보낼게요", "extra": ["보냈어요", "전화로"] },
    { "id": 819, "lessonId": "lesson-8", "grammarId": "g_l8_5", "zh": "如果手機沒電了，請借我充電器。", "kr": "배터리가 없으면 충전기 좀 빌려주세요", "extra": ["있으면", "사주세요"] },
    { "id": 820, "lessonId": "lesson-8", "grammarId": "g_l8_3", "zh": "現在通話有點困難呢。", "kr": "지금은 통화하기가 조금 어려운데요", "extra": ["쉬운데요", "좋은데요"] },
    { "id": 821, "lessonId": "lesson-8", "grammarId": ["g_l8_1", "g_l8_5"], "zh": "如果現在很忙的話，我待會再打。", "kr": "지금 많이 바쁘면 이따가 전화할게요", "extra": ["한가하면", "걸었어요"] },
    { "id": 822, "lessonId": "lesson-8", "grammarId": "g_l8_2", "zh": "請傳簡訊或用 KakaoTalk 聯絡。", "kr": "문자나 카톡으로 연락해 주세요", "extra": ["전화나", "만나요"] },
    { "id": 823, "lessonId": "lesson-8", "grammarId": "g_l8_4", "zh": "從朋友那裡收到了生日禮物。", "kr": "친구한테서 생일 선물을 받았어요", "extra": ["선물에", "주었어요"] },
    { "id": 824, "lessonId": "lesson-8", "grammarId": "g_l8_3", "zh": "剛剛沒聽清楚呢，請再說一次。", "kr": "잘 못 들었는데요 다시 말씀해 주세요", "extra": ["들었는데요", "보세요"] },
    { "id": 825, "lessonId": "lesson-8", "grammarId": "g_l8_1", "zh": "散步後我一定會打電話給您。", "kr": "산책한 후에 꼭 전화할게요", "extra": ["전에", "문자할게요"] }
  ]
}
