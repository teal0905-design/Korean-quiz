{
  "questions": [
    { "id": 901, "lessonId": "lesson-9", "grammarId": "g_l9_1", "zh": "夏天很熱，但冬天很冷。", "kr": "여름은 더운데 겨울은 추워요", "extra": ["봄은", "따뜻해요"] },
    { "id": 902, "lessonId": "lesson-9", "grammarId": "g_l9_1", "zh": "今天天氣很好，但有點颳風。", "kr": "오늘 날씨는 좋은데 바람이 불어요", "extra": ["비가", "더워요"] },
    { "id": 903, "lessonId": "lesson-9", "grammarId": "g_l9_2", "zh": "冬天可以在滑雪場滑雪。", "kr": "겨울에는 스키장에서 스키를 탈 수 있어요", "extra": ["여름에는", "없어요"] },
    { "id": 904, "lessonId": "lesson-9", "grammarId": "g_l9_2", "zh": "明天可以去賞楓。", "kr": "내일 단풍 구경을 갈 수 있어요", "extra": ["어제", "없어요"] },
    { "id": 905, "lessonId": "lesson-9", "grammarId": "g_l9_3", "zh": "下雨之後天氣放晴了。", "kr": "비가 온 후에 날씨가 갰어요", "extra": ["전에", "흐려요"] },
    { "id": 906, "lessonId": "lesson-9", "grammarId": "g_l9_3", "zh": "吃完飯後去散步吧。", "kr": "밥을 먹은 후에 산책을 해요", "extra": ["전에", "공부해요"] },
    { "id": 907, "lessonId": "lesson-9", "grammarId": ["g_l9_4", "g_l9_5"], "zh": "明天好像會比今天更溫暖。", "kr": "내일은 오늘보다 따뜻할 것 같아요", "extra": ["어제보다", "추울"] },
    { "id": 908, "lessonId": "lesson-9", "grammarId": "g_l9_4", "zh": "比起夏天，我更喜歡秋天。", "kr": "여름보다 가을을 더 좋아해요", "extra": ["겨울보다", "싫어해요"] },
    { "id": 909, "lessonId": "lesson-9", "grammarId": "g_l9_5", "zh": "天空中雲很多，好像快下雨了。", "kr": "구름이 많아서 비가 올 것 같아요", "extra": ["눈이", "맑을"] },
    { "id": 910, "lessonId": "lesson-9", "grammarId": "g_l9_5", "zh": "明天天氣好像會放晴。", "kr": "내일은 날씨가 맑을 것 같아요", "extra": ["어제는", "흐릴"] },
    { "id": 911, "lessonId": "lesson-9", "grammarId": "g_l9_6", "zh": "現在外面正在下雪。", "kr": "지금 밖에는 눈이 내리고 있어요", "extra": ["안에는", "비가"] },
    { "id": 912, "lessonId": "lesson-9", "grammarId": "g_l9_6", "zh": "風正在吹得很厲害。", "kr": "바람이 많이 불고 있어요", "extra": ["조금", "안개가"] },
    { "id": 913, "lessonId": "lesson-9", "grammarId": ["g_l9_1", "g_l9_5"], "zh": "今天天氣有點陰，好像會下雨。", "kr": "날씨가 흐린데 비가 올 것 같아요", "extra": ["맑은데", "눈이"] },
    { "id": 914, "lessonId": "lesson-9", "grammarId": "g_l9_4", "zh": "冬天比秋天冷得多。", "kr": "겨울이 가을보다 훨씬 추워요", "extra": ["봄보다", "따뜻해요"] },
    { "id": 915, "lessonId": "lesson-9", "grammarId": "g_l9_2", "zh": "在河邊可以釣魚。", "kr": "강에서 낚시를 할 수 있어요", "extra": ["바다에서", "없어요"] },
    { "id": 916, "lessonId": "lesson-9", "grammarId": "g_l9_6", "zh": "朋友們正在操場上運動。", "kr": "친구들이 운동장에서 운동을 하고 있어요", "extra": ["교실에서", "공부를"] },

    { "id": 1001, "lessonId": "lesson-10", "grammarId": ["g_l10_1", "g_l10_3"], "zh": "放假時打算去雪嶽山旅行。", "kr": "방학 때 설악산으로 여행을 가려고 해요", "extra": ["집으로", "갔어요"] },
    { "id": 1002, "lessonId": "lesson-10", "grammarId": "g_l10_1", "zh": "打算制定這次假期的計畫。", "kr": "이번 방학 계획을 세우려고 해요", "extra": ["지난", "세웠어요"] },
    { "id": 1003, "lessonId": "lesson-10", "grammarId": ["g_l10_1", "g_l10_2"], "zh": "放假兩個星期的期間要好好休息。", "kr": "이 주일 동안 푹 쉬려고 해요", "extra": ["전에", "일하려고"] },
    { "id": 1004, "lessonId": "lesson-10", "grammarId": "g_l10_2", "zh": "放假期間去濟州島旅行了。", "kr": "방학 동안 제주도로 여행을 갔어요", "extra": ["서울로", "가요"] },
    { "id": 1005, "lessonId": "lesson-10", "grammarId": "g_l10_3", "zh": "有時間的時候經常去爬山。", "kr": "시간이 있을 때 등산을 자주 해요", "extra": ["없을", "수영을"] },
    { "id": 1006, "lessonId": "lesson-10", "grammarId": ["g_l10_1", "g_l10_3"], "zh": "休假的時候打算去避暑。", "kr": "휴가 때 피서를 가려고 해요", "extra": ["겨울에", "낚시를"] },
    { "id": 1007, "lessonId": "lesson-10", "grammarId": "g_l10_4", "zh": "旅行過的地方中哪裡最好？", "kr": "여행한 곳 중에서 어디가 제일 좋았어요", "extra": ["누가", "나빴어요"] },
    { "id": 1008, "lessonId": "lesson-10", "grammarId": "g_l10_4", "zh": "運動之中我最喜歡足球。", "kr": "운동 중에서 축구를 제일 좋아해요", "extra": ["야구를", "가장"] },
    { "id": 1009, "lessonId": "lesson-10", "grammarId": "g_l10_4", "zh": "四季之中春天最好。", "kr": "사계절 중에서 봄이 가장 좋아요", "extra": ["겨울이", "나빠요"] },
    { "id": 1010, "lessonId": "lesson-10", "grammarId": "g_l10_5", "zh": "睡覺之前先看書。", "kr": "잠을 자기 전에 책을 읽어요", "extra": ["후에", "신문을"] },
    { "id": 1011, "lessonId": "lesson-10", "grammarId": "g_l10_5", "zh": "去旅行之前請先在網路訂票。", "kr": "여행을 가기 전에 인터넷으로 예매하세요", "extra": ["후에", "전화로"] },
    { "id": 1012, "lessonId": "lesson-10", "grammarId": "g_l10_5", "zh": "學桌球之前不太常做運動。", "kr": "탁구를 배우기 전에는 운동을 별로 안 했어요", "extra": ["후에는", "자주"] },
    { "id": 1013, "lessonId": "lesson-10", "grammarId": "g_l10_6", "zh": "今天因為太忙了所以無法運動。", "kr": "오늘은 너무 바빠서 운동을 못 해요", "extra": ["안", "잘"] },
    { "id": 1014, "lessonId": "lesson-10", "grammarId": "g_l10_6", "zh": "因為腳受傷了所以不能游泳。", "kr": "다리를 다쳐서 수영을 하지 못해요", "extra": ["않아요", "축구를"] },
    { "id": 1015, "lessonId": "lesson-10", "grammarId": "g_l10_6", "zh": "假日人很多，無法常去電影院。", "kr": "휴일에는 사람이 많아서 극장에 자주 못 가요", "extra": ["안", "공원에"] },
    { "id": 1016, "lessonId": "lesson-10", "grammarId": "g_l10_6", "zh": "雖然想去旅行，但因為沒有錢所以去不了。", "kr": "여행을 가고 싶지만 돈이 없어서 못 가요", "extra": ["안", "있어서"] }
  ]
