    { "id": 1001, "lessonId": "lesson-10", "zh": "這次放假我打算去雪嶽山。", "kr": "이번 방학에는 설악산에 가려고 해요", "extra": ["을", "가"] },
    { "id": 1002, "lessonId": "lesson-10", "zh": "6月初課程結束的話就是放假。", "kr": "육 월 초에 수업이 끝나면 방학이에요", "extra": ["를", "끝내면"] },
