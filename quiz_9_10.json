{
  "questions": [
    { "id": 901, "lessonId": "lesson-9", "zh": "我喜歡可以滑雪的冬天。", "kr": "저는 스키를 탈 수 있는 겨울이 좋아요", "extra": ["은", "가"] },
    { "id": 902, "lessonId": "lesson-9", "zh": "今年冬天我們要一起去滑雪場嗎？", "kr": "이번 겨울에는 같이 스키장에 갈까요", "extra": ["를", "은"] },
    { "id": 903, "lessonId": "lesson-9", "zh": "今天天氣有點陰陰的。", "kr": "오늘 날씨가 조금 흐린데요", "extra": ["에", "를"] },
