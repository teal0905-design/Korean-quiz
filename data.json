  "grammars": [
    {
      "id": "g_l1_1",
      "lessonId": "lesson-1",
      "title": "입니다",
      "formula": "名詞 + 입니다",
      "explanation": "接在名詞後，表示肯定身份或狀態「是...」。用於正式、客氣的場合。",
      "exampleKr": "【無尾音】：저<span class=\"hl-red\">는</span> 학생<span class=\"hl-red\">입니다</span>. (我是學生。)<br>【有尾音】：이것은 제 책상<span class=\"hl-red\">입니다</span>. (這是我的書桌。)"
    },
    {
      "id": "g_l1_2",
      "lessonId": "lesson-1",
      "title": "은 / 는",
      "formula": "名詞 + 은 / 는",
      "explanation": "主題助詞，用於介紹話題或形成對比。<br>• <b>有尾音</b> 接 <b>은</b><br>• <b>無尾音</b> 接 <b>는</b>",
      "exampleKr": "【有尾音】：서울<span class=\"hl-red\">은</span> 한국의 수도입니다. (首爾是韓國的首都。)<br>【無尾音】：저<span class=\"hl-red\">는</span> 대만 사람입니다. (我是台灣人。)"
    },
    {
      "id": "g_l1_3",
      "lessonId": "lesson-1",
      "title": "입니까?",
      "formula": "名詞 + 입니까?",
      "explanation": "「입니다」的疑問形式，用於正式場合詢問對方的身份、狀態或國籍。",
      "exampleKr": "【例句 1】：이분이 어느 나라 사람<span class=\"hl-red\">입니까?</span> (這位是哪國人？)<br>【例句 2】：회사원<span class=\"hl-red\">입니까?</span> (是上班族嗎？)"
    },
    {
      "id": "g_l1_4",
      "lessonId": "lesson-1",
      "title": "이 / 가 아닙니다",
      "formula": "名詞 + 이/가 아닙니다",
      "explanation": "否定助詞句型，表示「不是...」。<br>• <b>有尾音</b> 接 <b>이 아닙니다</b><br>• <b>無尾音</b> 接 <b>가 아닙니다</b>",
      "exampleKr": "【有尾音】：회사원<span class=\"hl-red\">이 아닙니다</span>. (不是公司職員。)<br>【無尾音】：의사<span class=\"hl-red\">가 아닙니다</span>. (不是醫生。)"
    },
    {
      "id": "g_l1_5",
      "lessonId": "lesson-1",
      "title": "-습니다 / -ㅂ니다",
      "formula": "動詞/形容詞詞幹 + 습니다 / ㅂ니다",
      "explanation": "正式場合的肯定陳述終結語尾。<br>• <b>有尾音</b> 接 <b>-습니다</b><br>• <b>無尾音</b> 接 <b>-ㅂ니다</b>",
      "exampleKr": "【有尾音】：책을 읽<span class=\"hl-red\">습니다</span>. (看書。) | 밥을 먹<span class=\"hl-red\">습니다</span>. (吃飯。)<br>【無尾音】：학교에 가<span class=\"hl-red\">ㅂ니다</span>. (去學校。) | 잠을 자<span class=\"hl-red\">ㅂ니다</span>. (睡覺。)"
    },
    {
      "id": "g_l1_6",
      "lessonId": "lesson-1",
      "title": "-습니까 / -ㅂ니까?",
      "formula": "動詞/形容詞詞幹 + 습니까 / ㅂ니까?",
      "explanation": "正式場合的疑問終結語尾。<br>• <b>有尾音</b> 接 <b>-습니까?</b><br>• <b>無尾音</b> 接 <b>-ㅂ니까?</b>",
      "exampleKr": "【有尾音】：무엇을 먹<span class=\"hl-red\">습니까?</span> (吃什麼？)<br>【無尾音】：어디에 가<span class=\"hl-red\">ㅂ니까?</span> (去哪裡？)"
    },
    {
      "id": "g_l2_1",
      "lessonId": "lesson-2",
      "title": "이 / 가",
      "formula": "名詞 + 이 / 가",
      "explanation": "主格助詞，標示句子的主語。<br>• <b>有尾音</b> 接 <b>이</b><br>• <b>無尾音</b> 接 <b>가</b><br>• 代名詞變化：나➔<b>내가</b>、저➔<b>제가</b>、누구➔<b>누가</b>",
      "exampleKr": "【有尾音】：이것<span class=\"hl-red\">이</span> 교과서입니다. (這是課本。)<br>【無尾音】：친구<span class=\"hl-red\">가</span> 많습니다. (朋友很多。)<br>【特殊】：제<span class=\"hl-red\">가</span> 김영수입니다. (我是金英秀。)"
    },
    {
      "id": "g_l2_2",
      "lessonId": "lesson-2",
      "title": "이 / 그 / 저",
      "formula": "이 / 그 / 저 + 名詞",
      "explanation": "冠形指示詞：<br>• <b>이 (這)</b>：靠近說話者<br>• <b>그 (那)</b>：靠近聽話者 / 雙方已知的事物<br>• <b>저 (那)</b>：離雙方都很遠",
      "exampleKr": "【離我近】：<span class=\"hl-red\">이</span> 책이 제 책입니다. (這本書是我的書。)<br>【離你近】：<span class=\"hl-red\">그</span> 연필을 주십시오. (請把那枝鉛筆給我。)<br>【遠方】：<span class=\"hl-red\">저</span> 건물이 우리 학교입니다. (那棟建築是我們學校。)"
    },
    {
      "id": "g_l2_3",
      "lessonId": "lesson-2",
      "title": "도",
      "formula": "名詞 + 도",
      "explanation": "列舉助詞，表示「也」。取代主格「이/가」或受格「을/를」，但接在「에、에서」之後時須保留（如：학교에도）。",
      "exampleKr": "【一般名詞】：책상이 있습니다. 의자<span class=\"hl-red\">도</span> 있습니다. (有桌子，也有椅子。)<br>【場所結合】：도서관에서 공부합니다. 집<span class=\"hl-red\">에서도</span> 공부합니다. (在圖書館念書，也在家念書。)"
    },
    {
      "id": "g_l2_4",
      "lessonId": "lesson-2",
      "title": "있다 / 없다",
